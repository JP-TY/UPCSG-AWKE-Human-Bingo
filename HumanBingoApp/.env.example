NODE_ENV=development
HOST=127.0.0.1
PORT=3000
BROWSER_DEV_PORT=5173
PREVIEW_PORT=4173
API_PATH=/api
WS_PATH=/ws
API_BASE_URL=/api
WS_URL=/ws
SHUTDOWN_TIMEOUT_MS=10000
DATABASE_URL=postgres://jpty:replace-with-local-role-password@localhost:5432/human_bingo
# Development bootstrap only: a separate loopback administrator connection.
DATABASE_ADMIN_URL=postgres://postgres@localhost:5432/postgres
DATABASE_ADMIN_PASSWORD=replace-with-local-admin-password
DATABASE_ROLE=jpty
DATABASE_ROLE_PASSWORD=replace-with-local-role-password
# Integration tests require an explicitly isolated database URL.
TEST_DATABASE_URL=postgres://localhost:5432/human_bingo_test
SESSION_SECRET=replace-with-a-development-secret-at-least-32-characters
PUBLIC_APP_ORIGIN=http://localhost:4173
# Optional. Origin used in invitation links and QR payloads when the API
# cannot derive it from the request. Defaults to PUBLIC_APP_ORIGIN. Set this
# to the public HTTPS origin in production (e.g. https://bingo.example).
#INVITATION_CANONICAL_BASE_URL=https://bingo.example
CORS_ORIGINS=http://localhost:4173
DATABASE_SSL_MODE=disable
COMPOSE_DATABASE_USER=human_bingo
COMPOSE_DATABASE_PASSWORD=replace-with-a-local-password
COMPOSE_DATABASE_NAME=human_bingo
BACKUP_DIR=./.backups
WAL_ARCHIVE_DIR=./.backups/wal
BACKUP_RETENTION_COUNT=7
MIGRATION_ROLLBACK_DATABASE_URL=postgres://localhost:5432/human_bingo_migration_check
