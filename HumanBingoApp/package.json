{
  "name": "human-bingo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b --pretty false",
    "build:web": "npm run build && npm run build --workspace @human-bingo/web",
    "typecheck": "tsc -b --pretty false",
    "typecheck:web": "npm run typecheck --workspace @human-bingo/web",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config vitest.unit.config.ts --coverage",
    "test:property": "vitest run --config vitest.property.config.ts --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts --coverage",
    "test:browser": "playwright test --config playwright.config.mjs",
    "test:browser:next": "playwright test --config playwright.next.config.mjs",
    "test:browser:install": "playwright install chromium",
    "test:browser:check": "node scripts/browser-check.mjs",
    "test:accessibility": "playwright test tests/browser/accessibility-responsive.spec.ts --config playwright.config.mjs",
    "validate:environment": "node scripts/validate-environment.mjs",
    "db:wait": "node scripts/db.mjs wait",
    "db:create": "node scripts/db.mjs create",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:reset": "node scripts/db.mjs reset",
    "db:status": "node scripts/db.mjs status",
    "migrate": "node scripts/migrate.mjs",
    "migrate:runtime": "node scripts/migrate-runtime.mjs",
    "migrate:rollback:check": "node scripts/migrate.mjs --check-rollback",
    "backup": "node scripts/backup.mjs",
    "backup:verify": "node scripts/verify-backup.mjs",
    "outbox:replay": "node scripts/replay-outbox.mjs",
    "test:all": "npm run typecheck && npm run lint && npm run test:unit && npm run test:property && npm run test:integration && npm run test:browser && npm run test:accessibility",
    "check": "npm run typecheck && npm run lint && npm run test:unit",
    "dev": "node scripts/lifecycle.mjs dev",
    "dev:web": "npm run dev --workspace @human-bingo/web",
    "start": "node scripts/lifecycle.mjs start",
    "start:web": "npm run start --workspace @human-bingo/web",
    "preview": "node scripts/lifecycle.mjs preview"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "22.13.10",
    "@types/pg": "8.21.0",
    "@typescript-eslint/eslint-plugin": "8.26.0",
    "@typescript-eslint/parser": "8.26.0",
    "@vitest/coverage-v8": "3.0.8",
    "eslint": "9.22.0",
    "fast-check": "4.0.0",
    "pg": "8.23.0",
    "prettier": "3.5.3",
    "typescript": "5.8.2",
    "typescript-eslint": "8.26.0",
    "vite": "6.4.3",
    "vitest": "3.0.8"
  }
}
