# Backup/PITR settings. Keep these values in a secret manager, not source control.
BACKUP_DIR=/var/backups/human-bingo
BACKUP_RETENTION_COUNT=7
WAL_ARCHIVE_DIR=/var/backups/human-bingo/wal
# PostgreSQL must be configured with archive_mode=on and archive_command targeting WAL_ARCHIVE_DIR.
# Restore validation uses a disposable database and scripts/verify-backup.mjs.
